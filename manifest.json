{
  "manifest_version": 3,
  "name": "Marketplace → eBay Lister Helper",
  "version": "2.0.0",
  "description": "Adds buttons next to the product title on Amazon, Walmart, AliExpress, and eBay listings to copy/download best-quality photos, and to auto-fill title, description, price, and photos into a new eBay listing.",
  "permissions": ["downloads", "activeTab", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.walmart.com/*",
    "*://*.aliexpress.com/*",
    "*://*.ebay.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.walmart.com/*",
        "*://*.aliexpress.com/*",
        "*://*.ebay.com/itm/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.ebay.com/sl/*"],
      "js": ["ebay-content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
